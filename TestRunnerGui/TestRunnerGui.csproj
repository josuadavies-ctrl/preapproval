<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- NUnit Engine for discovery and in-process control -->
    <PackageReference Include="NUnit.Engine" Version="3.13.3" />
    <PackageReference Include="NUnit.Engine.Api" Version="3.13.3" />
  </ItemGroup>
</Project>
